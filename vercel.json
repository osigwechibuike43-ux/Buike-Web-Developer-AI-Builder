{
  "redirects": [
    { "source": "/(.*)", "has": [{ "type": "host", "value": "www.buikeweb.name.ng" }], "destination": "https://buikeweb.name.ng/$1", "permanent": true },
    { "source": "/(.*)", "has": [{ "type": "host", "value": "buike-web-developer-ai-builder.vercel.app" }], "destination": "https://buikeweb.name.ng/$1", "permanent": true }
  ],
  "rewrites": [{ "source": "/blog/:slug", "destination": "/blog/:slug/index.html" }],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/(sitemap.xml|robots.txt)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=3600" }]
    },
    {
      "source": "/images/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=2592000" }]
    }
  ]
}
